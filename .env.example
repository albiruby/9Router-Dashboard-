# URL instance 9Router, tanpa garis miring di akhir.
# Port bawaan 9Router: 20128. Bisa juga alamat Tailscale/VPS kamu.
NINE_ROUTER_URL=http://localhost:20128

# 1 = mode demo (data contoh, tanpa koneksi ke 9Router), 0 = instance asli
NINE_ROUTER_MOCK=0

# Set true hanya jika aplikasi diakses lewat HTTPS
NINE_ROUTER_COOKIE_SECURE=false
